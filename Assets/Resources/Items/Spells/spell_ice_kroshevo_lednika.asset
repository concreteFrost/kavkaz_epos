  itemName: "\u041A\u0440\u043E\u0448\u0435\u0432\u043E \u043B\u0435\u0434\u043D\u0438\u043A\u0430"
  itemImage: {fileID: 21300006, guid: fe5ea5af009a35040b24bb1e50343b4a, type: 3}
  itemDescription: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
    \u043B\u0435\u0434\u043D\u0438\u043A \u0442\u0440\u0435\u0441\u043A\u0430\u0435\u0442\u0441\u044F,
    \u0438\u0437 \u0435\u0433\u043E \u0442\u043E\u043B\u0449\u0438 \u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F
    \u043E\u0441\u0442\u0440\u044B\u0435 \u043E\u0431\u043B\u043E\u043C\u043A\u0438.
    \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u0442\u0435\u043B\u044C \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
    \u0438\u0445 \u0433\u043E\u0440\u0441\u0442\u044C\u044E: \u043A\u0440\u043E\u0448\u0435\u0432\u043E
    \u0432\u0437\u043C\u044B\u0432\u0430\u0435\u0442 \u043D\u0430\u0434 \u0437\u0435\u043C\u043B\u0451\u0439
    \u0438 \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u0432\u0440\u0430\u0433\u043E\u0432,
    \u0432\u043F\u0438\u0432\u0430\u044F\u0441\u044C \u0432 \u043F\u043B\u043E\u0442\u044C
    \u043B\u0435\u0434\u044F\u043D\u044B\u043C\u0438 \u043A\u0440\u0430\u044F\u043C\u0438."
