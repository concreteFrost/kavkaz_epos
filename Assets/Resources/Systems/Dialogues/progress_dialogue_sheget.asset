%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4040521ec8432a4b8162e4a2ff79866, type: 3}
  m_Name: progress_dialogue_sheget
  m_EditorClassIdentifier: Assembly-CSharp::NpcProgressiveDialoguesSO
  introductionDialogueLines:
  - dialogueLine: "\u0413\u0434\u0435 \u0442\u044B \u0445\u043E\u0434\u0438\u043B,
      \u0441\u044B\u043D \u043C\u043E\u0439?"
  - dialogueLine: "\u041F\u043E\u0433\u043B\u044F\u0434\u0438 \u0447\u0442\u043E
      \u0441\u0442\u0430\u043B\u043E \u0441 \u043D\u0430\u0448\u0438\u043C \u0430\u0443\u043B\u043E\u043C..."
  neutralDialogueLines:
  - minProgress: 0
    dialogueLines:
    - dialogueLine: "\u0421\u0442\u0443\u043F\u0430\u0439, \u0441\u044B\u043D \u043C\u043E\u0439,
        \u0442\u0435\u0431\u0435 \u0435\u0441\u0442\u044C \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F."
    - dialogueLine: "\u0417\u0434\u0435\u0441\u044C \u0438 \u0431\u0435\u0437 \u0442\u0432\u043E\u0435\u0439
        \u043F\u043E\u043C\u043E\u0449\u0438 \u0440\u0430\u0431\u043E\u0442\u044B
        \u043D\u0435\u0432\u043F\u0440\u043E\u0432\u043E\u0440\u043E\u0442."
  - minProgress: 1
    dialogueLines:
    - dialogueLine: "\u0425\u043C... \u0414\u0430\u0432\u043D\u043E \u044F \u043D\u0435
        \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E\u0431\u044B \u0432
        \u0430\u0443\u043B\u0435 \u0431\u044B\u043B\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432."
    - dialogueLine: "\u0412\u0438\u0434\u0438\u043C\u043E, \u043D\u0435 \u0432\u0441\u0451
        \u0435\u0449\u0451 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
  - minProgress: 2
    dialogueLines:
    - dialogueLine: "\u041B\u044E\u0434\u0438 \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u0430\u043B\u0438
        \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0437\u0430\u043A\u0430\u0437\u044B."
    - dialogueLine: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u043E\u043C\u0443-\u0442\u043E
        \u0441\u043D\u043E\u0432\u0430 \u043D\u0443\u0436\u043D\u043E \u043E\u0440\u0443\u0436\u0438\u0435."
  - minProgress: 3
    dialogueLines:
    - dialogueLine: "\u0412\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0430\u0431\u043E\u0442\u044B.
        \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0437\u043D\u0430\u043A."
    - dialogueLine: "\u041C\u043E\u0436\u0435\u0442, \u0441\u043A\u043E\u0440\u043E
        \u044F \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u043D\u0443 \u043A\u043E\u0432\u0430\u0442\u044C
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0432\u043E\u0439\u043D\u044B."
  - minProgress: 4
    dialogueLines:
    - dialogueLine: "\u0412\u0438\u0434\u0438\u0448\u044C? \u041A\u0443\u0437\u043D\u044F
        \u043E\u043F\u044F\u0442\u044C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442."
    - dialogueLine: "\u0410 \u044F \u0443\u0436 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E
        \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0443\u0432\u0438\u0436\u0443
        \u044D\u0442\u043E\u0433\u043E."
  - minProgress: 5
    dialogueLines:
    - dialogueLine: "\u0421\u0442\u0430\u043B\u044C \u0441\u043D\u043E\u0432\u0430
        \u043D\u0443\u0436\u043D\u0430 \u043B\u044E\u0434\u044F\u043C."
    - dialogueLine: "\u0422\u043E\u043B\u044C\u043A\u043E \u0431\u044B \u0438\u043C
        \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
        \u0442\u0430\u043A \u0447\u0430\u0441\u0442\u043E \u0435\u0451 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
  - minProgress: 6
    dialogueLines:
    - dialogueLine: "\u0415\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E,
        \u0438 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0431\u044B\u0442\u044C
        \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0435\u0441\u043A\u043E\u043D\u0447\u0430\u0435\u043C\u043E\u043C
        \u0443\u0436\u0430\u0441\u0435..."
  - minProgress: 7
    dialogueLines:
    - dialogueLine: "\u041D\u0443 \u0432\u043E\u0442... \u0441\u043D\u043E\u0432\u0430
        \u0435\u0441\u0442\u044C \u0440\u0430\u0434\u0438 \u043A\u043E\u0433\u043E
        \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C."
    - dialogueLine: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0441\u044B\u043D\u043E\u043A."
